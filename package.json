{
  "name": "simple-site",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\" && npm run build:css && WRITING_PREVIEW=0 npx @11ty/eleventy",
    "build:css": "npx postcss src/styles.css -o _site/styles.css",
    "dev": "npm run build:css && WRITING_PREVIEW=1 npx @11ty/eleventy --serve --port=8081"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/typography": "^0.5.16",
    "alpinejs": "^3.13.3",
    "autoprefixer": "^10.4.21",
    "eleventy": "latest",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "lucide": "^0.525.0"
  }
}
