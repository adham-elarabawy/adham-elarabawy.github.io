---
layout: layout.njk
---
<article class="writing-article">
  <a href="/blog/" class="writing-back">&larr; All writing</a>
  <header class="writing-header">
    {% if headingImage %}
    <h1 class="sr-only">{{ title }}</h1>
    <img class="writing-heading-image" src="{{ headingImage }}" alt="{{ headingAlt or title }}" {% if headingWidth and headingHeight %}width="{{ headingWidth }}" height="{{ headingHeight }}"{% endif %} />
    <p class="writing-mobile-title" aria-hidden="true">{{ title }}</p>
    {% else %}
    <h1>{{ title }}</h1>
    {% endif %}
    {% if status == "in-progress" %}
    <p class="writing-meta">In progress</p>
    {% else %}
    <p class="writing-meta"><time datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ page.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) }}</time></p>
    {% endif %}
  </header>
  <div class="writing-body">{{ content | safe }}</div>
</article>
