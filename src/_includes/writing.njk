---
layout: layout.njk
---
<article class="writing-article">
  <a href="/blog/" class="writing-back">&larr; All writing</a>
  <header class="writing-header">
    <h1 class="writing-title">{{ title }}</h1>
    <p class="writing-date"><time datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ page.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) }}</time></p>
    {% if headingImage %}
    <div class="writing-paper">
    <img class="writing-heading-image" src="{{ headingImage }}" alt="{{ headingAlt or title }}" {% if headingWidth and headingHeight %}width="{{ headingWidth }}" height="{{ headingHeight }}"{% endif %} />
    </div>
    {% if headingText %}<p class="writing-mobile-title" aria-hidden="true">{{ headingText }}</p>{% endif %}
    {% endif %}
  </header>
  <div class="writing-body">{{ content | safe }}</div>
</article>
