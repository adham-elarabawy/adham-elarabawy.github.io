<li class="flex flex-col sm:flex-row items-start gap-y-2 sm:gap-y-0 sm:gap-x-3 py-3 sm:py-2.5 pl-0 first:pt-0">
<div class="w-full sm:w-28 md:w-40 shrink-0 overflow-hidden rounded-sm">
{% if project.data.external_url %}<a href="{{ project.data.external_url }}" target="_blank" rel="noopener" class="block no-underline" aria-label="View {{ project.data.title }}">{% else %}<a href="{{ project.url }}" class="block no-underline" aria-label="View {{ project.data.title }}">{% endif %}<img src="{{ project.data.image }}" alt="{{ project.data.title }}" class="m-0 w-full aspect-[5/4] object-cover object-center" />
</a>
</div>
<div class="min-w-0 w-full">
<p class="m-0 mb-0.5 text-xs text-gray-400 tracking-wide uppercase">{{ project.data.date | date: "%B %Y" }}</p>
<h3 class="m-0 mb-0.5 text-sm md:text-base font-semibold text-text leading-snug">{% if project.data.external_url %}<a href="{{ project.data.external_url }}" target="_blank" rel="noopener" class="hover:text-accent-600 transition no-underline">{{ project.data.title }}</a>{% else %}<a href="{{ project.url }}" class="hover:text-accent-600 transition no-underline">{{ project.data.title }}</a>{% endif %}</h3>
{% if project.data.description %}<p class="m-0 text-sm text-gray-600 leading-snug">{{ project.data.description }}</p>{% endif %}
{% if project.data.authors %}<p class="m-0 mt-1.5 text-xs text-gray-500 leading-[1.4]">{% for author in project.data.authors %}{% if author == "Adham Elarabawy" %}<strong class="font-semibold text-gray-700">{{ author }}</strong>{% else %}{{ author }}{% endif %}{% if project.data.equal_contributors contains author %}<sup class="ml-px">&#42;</sup>{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}{% if project.data.affiliation %}<span class="mx-1 text-gray-300" aria-hidden="true">·</span><span class="italic font-medium text-gray-500">{{ project.data.affiliation }}</span>{% endif %}</p>{% endif %}
</div>
</li>
